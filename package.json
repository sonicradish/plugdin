{
  "name": "pluggedin",
  "version": "0.2.0",
  "description": "Decides which plugins, skills, and MCP servers are active in a coding-agent session, portable across agent clients.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonicradish/pluggedin.git"
  },
  "homepage": "https://github.com/sonicradish/pluggedin#readme",
  "bugs": {
    "url": "https://github.com/sonicradish/pluggedin/issues"
  },
  "keywords": [
    "cli",
    "claude-code",
    "codex",
    "pi",
    "opencode",
    "grok",
    "mcp",
    "plugins",
    "skills"
  ],
  "bin": {
    "pluggedin": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
